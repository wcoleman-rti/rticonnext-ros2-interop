# Add this package to the list of available generators
set(connextidl_typesupport_cpp2_FOUND TRUE)

# Register this generator with the rosidl system
ament_register_extension(
  "rosidl_generate_idl_interfaces"
  "connextidl_typesupport_cpp2"
  "connextidl_typesupport_cpp2_generate_interfaces.cmake"
)